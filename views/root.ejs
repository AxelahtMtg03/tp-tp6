<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Réducteur d'URL</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 640px;
        margin: 3rem auto;
        padding: 0 1rem;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 1.5rem 0;
      }
      input,
      button {
        padding: 0.5rem;
        font-size: 1rem;
      }
      code {
        background: #f2f2f2;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <h1>Réducteur d'URL</h1>
    <p><%= count %> lien(s) enregistré(s).</p>

    <% if (link) { %>
      <p>Lien créé :</p>
      <p>
        <a href="<%= link.shortUrl %>"><%= link.shortUrl %></a>
        → <code><%= link.url %></code>
      </p>
    <% } %>

    <form method="post" action="/api-v2/" id="submit-link">
      <label for="url">Type the URL to shorten</label>
      <input
        name="url"
        id="url"
        type="url"
        placeholder="https://perdu.com"
        required
      />
      <button type="submit">Submit</button>
    </form>
  </body>
</html>